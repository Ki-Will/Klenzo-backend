  "scripts": {
    "dev": "nx run-many -t serve -p auth-service finance-service productivity-service habit-service notification-service insight-service",
    "dev:auth": "nx serve auth-service",
    "dev:finance": "nx serve finance-service",
    "dev:productivity": "nx serve productivity-service",
    "dev:habit": "nx serve habit-service",
    "dev:notification": "nx serve notification-service",
    "dev:insight": "nx serve insight-service",
    "dev:monolith": "nx serve klenzo",
    "dev:klenzo": "nx serve klenzo",
    "build": "nx run-many -t build -p auth-service finance-service productivity-service habit-service notification-service insight-service",
    "build:auth": "nx build auth-service --configuration=production",
    "build:finance": "nx build finance-service --configuration=production",
    "build:productivity": "nx build productivity-service --configuration=production",
    "build:habit": "nx build habit-service --configuration=production",
    "build:notification": "nx build notification-service --configuration=production",
    "build:insight": "nx build insight-service --configuration=production",
    "start:auth": "node dist/apps/auth-service/main.js",
    "start:finance": "node dist/apps/finance-service/main.js",
    "start:productivity": "node dist/apps/productivity-service/main.js",
    "start:habit": "node dist/apps/habit-service/main.js",
    "start:notification": "node dist/apps/notification-service/main.js",
    "start:insight": "node dist/apps/insight-service/main.js",
    "start": "node dist/apps/klenzo/main.js",
    "start:monolith": "node dist/apps/klenzo/main.js",
    "docker:build:auth": "docker build -f apps/auth-service/Dockerfile -t klenzo/auth-service .",
    "docker:build:finance": "docker build -f apps/finance-service/Dockerfile -t klenzo/finance-service .",
    "docker:build:productivity": "docker build -f apps/productivity-service/Dockerfile -t klenzo/productivity-service .",
    "docker:build:habit": "docker build -f apps/habit-service/Dockerfile -t klenzo/habit-service .",
    "docker:build:notification": "docker build -f apps/notification-service/Dockerfile -t klenzo/notification-service .",
    "docker:build:insight": "docker build -f apps/insight-service/Dockerfile -t klenzo/insight-service .",
    "docker:build:all": "npm run docker:build:auth && npm run docker:build:finance && npm run docker:build:productivity && npm run docker:build:habit && npm run docker:build:notification && npm run docker:build:insight",
    "lint": "nx run-many -t lint -p auth-service finance-service productivity-service habit-service notification-service insight-service",
    "lint:auth": "nx lint auth-service",
    "lint:finance": "nx lint finance-service",
    "test": "nx run-many -t test -p auth-service finance-service productivity-service habit-service notification-service insight-service",
    "typecheck": "nx run-many -t typecheck -p auth-service finance-service productivity-service habit-service notification-service insight-service",
    "typecheck:auth": "nx typecheck auth-service",
    "typecheck:finance": "nx typecheck finance-service",
    "graph": "nx graph",
    "graph:services": "nx graph --focus=auth-service,finance-service,productivity-service,habit-service,notification-service,insight-service",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma dbPush",
    "db:migrate": "npx prisma migrate deploy",
    "db:studio": "npx prisma studio",
    "seed": "dotenv -e .env -- ts-node --project apps/klenzo/tsconfig.app.json --require reflect-metadata apps/klenzo/src/seed.ts"
  },
  "private": true,
