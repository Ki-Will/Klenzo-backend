# ── Stage 1: Build & Dependencies ──────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache python3 make g++

# Copy package descriptors
COPY package.json package-lock.json tsconfig.base.json nx.json ./
COPY prisma ./prisma/

# Install dependencies
RUN npm ci

# Copy source files
COPY apps ./apps
COPY libs ./libs
COPY scripts ./scripts

# Generate Prisma Client
RUN npx prisma generate

# Build target app passed via build-arg (default: klenzo)
ARG APP_NAME=klenzo
ENV APP_NAME=${APP_NAME}

# Build a single microservice — Nx builds only that project and its deps
RUN npx nx build ${APP_NAME} --configuration=production

# ── Stage 2: Production Minimal Runtime ────────────────────────────────────
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Security: Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nestjs -u 1001

# Copy build artifacts
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma

# Install production dependencies only (skips dev toolchains like webpack/nx)
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Set user context
USER nestjs

ARG APP_NAME=klenzo
ENV APP_NAME=${APP_NAME}
ENV PORT=3000

EXPOSE ${PORT}

# Health check (healthz is excluded from the /api global prefix)
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:' + (process.env.PORT || 3000) + '/healthz', (res) => { process.exit(res.statusCode === 200 ? 0 : 1); });"

# Dynamic startup command
CMD node dist/apps/${APP_NAME}/main.js
