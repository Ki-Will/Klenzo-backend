# Default Workspace Configs
NODE_ENV=development

# ----- NATS JetStream -----
NATS_SERVERS=nats://localhost:4222

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ----- Database -----
DB_HOST=localhost
DB_PORT=5432
DB_USER=klenzo
DB_PASSWORD=klenzo_password
DB_NAME=klenzo_db
DATABASE_URL=postgresql://klenzo:klenzo_password@localhost:5432/klenzo_db

# ----- JWT Secrets -----
JWT_SECRET=secret_key

# ----- Service Ports -----
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
FINANCE_SERVICE_PORT=3002
PRODUCTIVITY_SERVICE_PORT=3003
HABIT_SERVICE_PORT=3004
INSIGHT_SERVICE_PORT=3005
NOTIFICATION_SERVICE_PORT=3006

# ----- MinIO (Object Storage) -----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=klenzo_admin
MINIO_SECRET_KEY=klenzo_password
MINIO_USE_SSL=false