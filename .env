# Klenzo - Single Application Config
NODE_ENV=development

# ----- Application -----
PORT=3000
CORS_ORIGIN=*

# ----- Database -----
DB_HOST=localhost
DB_PORT=5432
DB_USER=klenzo
DB_PASSWORD=klenzo_password
DB_NAME=klenzo_db
DATABASE_URL=postgresql://klenzo:klenzo_password@localhost:5432/klenzo_db

# ----- JWT Secrets -----
JWT_SECRET=secret_key

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ----- Email (SMTP) -----
SMTP_HOST=localhost
SMTP_PORT=1025

# ----- MinIO (Object Storage) -----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=klenzo_admin
MINIO_SECRET_KEY=klenzo_password
MINIO_USE_SSL=false

# ----- Object Storage (MinIO Local Testing) -----

R2_BUCKET_NAME=klenzo-bucket
R2_PUBLIC_URL=http://localhost:9000/klenzo-bucket
R2_ENDPOINT_URL=http://localhost:9000
R2_ACCESS_KEY_ID=klenzo_admin
R2_SECRET_ACCESS_KEY=klenzo_password

# Frontend
FRONTEND_URL="http://localhost:5000"
