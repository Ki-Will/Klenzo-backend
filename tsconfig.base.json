{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@config/*": ["apps/klenzo/src/app/config/*"],
      "@prisma/*": ["apps/klenzo/src/app/prisma/*"],
      "@redis/*": ["apps/klenzo/src/app/redis/*"],
      "@logger/*": ["apps/klenzo/src/app/logger/*"],
      "@auth/*": ["apps/klenzo/src/app/auth/*"],
      "@kyc/*": ["apps/klenzo/src/app/kyc/*"],
      "@finance/*": ["apps/klenzo/src/app/finance/*"],
      "@wallet/*": ["apps/klenzo/src/app/wallet/*"],
      "@transfers/*": ["apps/klenzo/src/app/transfers/*"],
      "@payroll/*": ["apps/klenzo/src/app/payroll/*"],
      "@habit/*": ["apps/klenzo/src/app/habit/*"],
      "@productivity/*": ["apps/klenzo/src/app/productivity/*"],
      "@notification/*": ["apps/klenzo/src/app/notification/*"],
      "@insight/*": ["apps/klenzo/src/app/insight/*"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist", "**/*.spec.ts", "**/*.test.ts"]
}
