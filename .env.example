# Klenzo Backend Configuration
# Copy this file to .env and update the values

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5000

# ── Database (Neon PostgreSQL) ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/klenzo_db?schema=public

# ── JWT Secrets ─────────────────────────────────────────────────────────────
JWT_SECRET=your_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=15m

# ── Redis (Upstash / Redis Cloud) ──────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false
REDIS_URL=redis://localhost:6379

# ── Service Discovery (gRPC) ───────────────────────────────────────────────
# Auth Service
AUTH_SERVICE_PORT=3001
AUTH_GRPC_PORT=5001
AUTH_GRPC_URL=localhost:5001

# Finance Service
FINANCE_SERVICE_PORT=3002
FINANCE_GRPC_PORT=5002
FINANCE_GRPC_URL=localhost:5002

# Productivity Service
PRODUCTIVITY_SERVICE_PORT=3003

# Habit Service
HABIT_SERVICE_PORT=3004

# Notification Service
NOTIFICATION_SERVICE_PORT=3005

# Insight Service
INSIGHT_SERVICE_PORT=3006

# ── Email (SMTP) ───────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost

# ── Object Storage (Cloudflare R2 / MinIO) ─────────────────────────────────
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=http://localhost:9000
R2_ENDPOINT_URL=http://localhost:9000
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_REGION=auto

# ── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Google OAuth (login with Google) ────────────────────────────────────────
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# The redirect URI registered in Google Cloud Console (must match exactly)
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── MFA (Authenticator App / TOTP) ─────────────────────────────────────────
# Display name shown in authenticator apps (e.g. Google Authenticator, Authy)
MFA_ISSUER=Klenzo

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
