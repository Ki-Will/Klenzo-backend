# ─────────────────────────────────────────────────────────────────────────────
# Klenzo — Development image
#
# HOW HOT-RELOAD WORKS:
#   1. docker-compose mounts the entire workspace into /app at runtime.
#   2. node_modules is kept in a named Docker volume so the host never
#      overwrites the container's installed packages.
#   3. `nx serve <service>` runs webpack in watch mode (poll: 1000ms).
#      Webpack detects file changes → rebuilds → @nx/js:node restarts the
#      Node process automatically. No manual restart needed.
#
# The service is selected with the APP_NAME build-arg, e.g.:
#   docker build -f Dockerfile.dev --build-arg APP_NAME=auth-service .
# ─────────────────────────────────────────────────────────────────────────────
FROM node:20-alpine

WORKDIR /app

# Install dependencies as a separate layer so they are cached between builds.
# The actual source is NOT copied here — it comes in via the volume mount.
COPY package*.json ./
RUN npm config set fetch-retry-maxtimeout 600000 && \
    npm config set fetch-retries 5 && \
    npm ci

# Copy only the config files needed to resolve the Nx workspace.
# These rarely change, so they stay cached too.
COPY nx.json tsconfig*.json ./

# Copy Prisma schema so @prisma/client's postinstall can generate the client
# during npm ci. The rest of the source arrives via the volume mount.
COPY prisma ./prisma/

ARG APP_NAME=klenzo
ENV APP_NAME=${APP_NAME}

EXPOSE 3000

# The @nx/js:node serve executor runs webpack in watch mode (poll: 1000ms)
# and restarts the Node process on every rebuild. No manual restart needed.
CMD ["sh", "-c", "npx nx serve ${APP_NAME} --configuration=development"]
