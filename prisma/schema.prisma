// Klenzo Consolidated V2 Prisma Schema File

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "productivity", "habit", "finance", "notifications", "platform", "public"]
}

// ── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
  SUPERADMIN

  @@schema("auth")
}

enum AdminRoleCode {
  SUPER_ADMIN
  OPERATIONS_ADMIN
  FINANCE_RISK_ADMIN
  SUPPORT_ADMIN
  ANALYTICS_ADMIN

  @@schema("auth")
}

enum TransactionStatus {
  PENDING
  APPROVED
  FAILED
  REJECTED

  @@schema("finance")
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  PAYROLL

  @@schema("finance")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED

  @@schema("productivity")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR

  @@schema("notifications")
}

enum NotificationCategory {
  NOTIFICATION
  BANNER
  INSIGHT
  TRANSACTION
  SECURITY
  GROUP

  @@schema("notifications")
}

enum HabitFrequency {
  DAILY
  WEEKLY

  @@schema("habit")
}

enum BudgetPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM

  @@schema("finance")
}

enum TransferType {
  P2P
  MOBILE_MONEY
  BANK_TRANSFER

  @@schema("finance")
}

enum TransferStatus {
  INITIATED
  PROCESSING
  COMPLETED
  FAILED

  @@schema("finance")
}

enum KycTier {
  TIER_0
  TIER_1
  TIER_2
  TIER_3

  @@schema("auth")
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED

  @@schema("auth")
}

enum LedgerEntryType {
  DEBIT
  CREDIT

  @@schema("finance")
}

enum LedgerEntryStatus {
  PENDING
  POSTED
  REVERSED

  @@schema("finance")
}

enum ReconciliationStatus {
  MATCHED
  UNMATCHED
  AMOUNT_MISMATCH
  STATUS_MISMATCH
  DUPLICATE
  PENDING
  RESOLVED

  @@schema("finance")
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@schema("finance")
}

enum RiskDecision {
  ALLOW
  REVIEW
  BLOCK
  ESCALATE

  @@schema("finance")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED

  @@schema("finance")
}

enum ApprovalType {
  TRANSACTION_REVERSAL
  WALLET_ADJUSTMENT
  REFUND
  PROVIDER_DISABLEMENT
  LIMIT_CHANGE
  ACCOUNT_RESTRICTION

  @@schema("finance")
}

// ── AUTH SCHEMA ─────────────────────────────────────────────────────────────

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  lastLogin            DateTime?
  isActive             Boolean   @default(true)
  refreshToken         String?
  refreshTokenExpires  DateTime?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  failedLoginAttempts  Int       @default(0)
  role                 Role      @default(USER)
  name                 String?
  phone                String?
  avatar               String?
  notificationSettings Json?

  // OAuth (Google)
  googleId String? @unique

  // Multi-Factor Authentication (TOTP authenticator app)
  mfaSecret  String?
  mfaEnabled Boolean  @default(false)

  // Relations
  transactions      Transaction[]
  groups            Group[]
  budgets           Budget[]
  accounts          Account[]
  wallets           Wallet[]
  transfersSent     Transfer[]        @relation("TransfersSent")
  habits            Habit[]
  tasks             Task[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  kycRecord         KycRecord?
  payrollEmployees  PayrollEmployee[]
  adminRoles        AdminUserRole[]
  consentRecords    ConsentRecord[]
  approvalRequests  ApprovalRequest[] @relation("ApprovalRequestedBy")
  approvalActions   ApprovalRequest[] @relation("ApprovalApprovedBy")

  @@map("users")
  @@schema("auth")
  @@index([email, isActive])
  @@index([createdAt])
}

model KycRecord {
  id             String    @id @default(uuid())
  userId         String    @unique
  tier           KycTier   @default(TIER_0)
  status         KycStatus @default(NOT_SUBMITTED)
  documentType   String?
  documentNumber String?
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_records")
  @@schema("auth")
  @@index([status])
}

// ── RBAC SCHEMA (AUTH) ─────────────────────────────────────────────────────

model AdminRole {
  id          String        @id @default(uuid())
  code        AdminRoleCode @unique
  name        String
  description String?
  isSystem    Boolean       @default(true)
  isActive    Boolean       @default(true)
  permissions AdminRolePermission[]
  users       AdminUserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_roles")
  @@schema("auth")
}

model Permission {
  id          String @id @default(uuid())
  resource    String
  action      String
  description String?
  roles       AdminRolePermission[]

  @@unique([resource, action])
  @@map("permissions")
  @@schema("auth")
}

model AdminRolePermission {
  roleId       String
  permissionId String

  role       AdminRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
  @@schema("auth")
}

model AdminUserRole {
  userId String
  roleId String

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("admin_user_roles")
  @@schema("auth")
}

// ── CONSENT SCHEMA (AUTH) ───────────────────────────────────────────────

enum ConsentType {
  PRIVACY_POLICY
  TERMS_OF_SERVICE
  MARKETING
  ANALYTICS
  DATA_SHARING

  @@schema("auth")
}

model ConsentRecord {
  id           String       @id @default(uuid())
  userId       String
  consentType  ConsentType
  granted      Boolean
  version      String
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime     @default(now())
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, consentType])
  @@map("consent_records")
  @@schema("auth")
  @@index([userId])
  @@index([consentType])
}

model PolicyVersion {
  id              String   @id @default(uuid())
  policyType      String
  version         String
  effectiveDate   DateTime
  contentUrl      String?
  isActive        Boolean  @default(true)
  requiresConsent Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([policyType, version])
  @@map("policy_versions")
  @@schema("auth")
  @@index([policyType])
  @@index([isActive])
}

// ── PLATFORM SCHEMA ────────────────────────────────────────────────────────

model FeatureFlag {
  id               String   @id @default(uuid())
  name             String   @unique
  description      String?
  isEnabled        Boolean  @default(false)
  rolloutPercent   Int      @default(0)
  allowedUsers     String[]
  allowedRoles     String[]
  allowedCountries String[]
  metadata         Json?
  createdById      String?
  updatedById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("feature_flags")
  @@schema("platform")
}

// ── PRODUCTIVITY SCHEMA ─────────────────────────────────────────────────────

model Task {
  id          String     @id @default(uuid())
  userId      String
  title       String
  description String?
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  priority    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tasks")
  @@schema("productivity")
  @@index([userId, status])
  @@index([dueDate])
}

// ── HABIT SCHEMA ────────────────────────────────────────────────────────────

model Habit {
  id                String         @id @default(uuid())
  userId            String
  name              String
  description       String?
  frequency         HabitFrequency
  currentStreak     Int            @default(0)
  longestStreak     Int            @default(0)
  lastCompletedDate DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@map("habits")
  @@schema("habit")
  @@index([userId])
}

model HabitLog {
  id          String   @id @default(uuid())
  habitId     String
  completedAt DateTime
  createdAt   DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@map("habit_logs")
  @@schema("habit")
  @@index([habitId, completedAt])
}

// ── FINANCE SCHEMA ──────────────────────────────────────────────────────────

model Wallet {
  id            String   @id @default(uuid())
  userId        String
  name          String   @default("Main Wallet")
  currency      String   @default("USD")
  balance       Decimal  @default(0)
  accountNumber String   @unique
  isPrimary     Boolean  @default(false)
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ledgerEntries LedgerEntry[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
  @@schema("finance")
  @@index([userId, isPrimary])
}

model Transfer {
  id          String         @id @default(uuid())
  senderId    String
  recipient   String
  amount      Decimal
  currency    String         @default("USD")
  type        TransferType   @default(P2P)
  status      TransferStatus @default(COMPLETED)
  reference   String         @unique
  date        DateTime       @default(now())

  ledgerEntries LedgerEntry[]

  sender User @relation("TransfersSent", fields: [senderId], references: [id])

  @@map("transfers")
  @@schema("finance")
  @@index([senderId, date])
  @@index([status])
}

model PayrollRun {
  id          String   @id @default(uuid())
  period      String
  totalAmount Decimal
  status      String   @default("READY")
  createdAt   DateTime @default(now())

  @@map("payroll_runs")
  @@schema("finance")
  @@index([createdAt])
}

model PayrollEmployee {
  id        String   @id @default(uuid())
  userId    String?
  name      String
  role      String
  salary    Decimal
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("payroll_employees")
  @@schema("finance")
  @@index([userId])
}

model Group {
  id        String   @id @default(uuid())
  name      String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [createdBy], references: [id])
  members      GroupMember[]
  transactions Transaction[]

  @@map("groups")
  @@schema("finance")
  @@index([createdBy])
}

model GroupMember {
  id        String   @id @default(uuid())
  userId    String
  email     String
  groupId   String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("group_members")
  @@schema("finance")
  @@index([groupId, userId])
}

model Account {
  id        String   @id @default(uuid())
  userId    String
  name      String
  balance   Decimal  @default(0)
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("accounts")
  @@schema("finance")
  @@index([userId])
}

model Budget {
  id          String       @id @default(uuid())
  userId      String
  name        String       @default("General Budget")
  category    String?
  type        String       @default("expense")
  limitAmount Decimal
  spent       Decimal      @default(0)
  period      BudgetPeriod @default(MONTHLY)
  color       String?
  icon        String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("budgets")
  @@schema("finance")
  @@index([userId, category])
}

model Transaction {
  id                  String            @id @default(uuid())
  userId              String
  groupId             String?
  accountId           String?
  parentTransactionId String?
  status              TransactionStatus @default(APPROVED)
  transactionType     TransactionType   @default(EXPENSE)
  amount              Decimal
  description         String?
  category            String?
  budgetId            String?
  date                DateTime
  createdAt           DateTime          @default(now())

  user              User?         @relation(fields: [userId], references: [id])
  group             Group?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  account           Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  budget            Budget?       @relation(fields: [budgetId], references: [id])
  parentTransaction Transaction?  @relation("ParentTransaction", fields: [parentTransactionId], references: [id], onDelete: SetNull)
  childTransactions Transaction[] @relation("ParentTransaction")
  ledgerEntries    LedgerEntry[]
  riskAssessments  RiskAssessment[]
  reconciliations  ReconciliationRecord[]

  @@map("transactions")
  @@schema("finance")
  @@index([userId, date])
  @@index([groupId, date])
  @@index([status])
  @@index([budgetId])
  @@index([accountId])
}

// ── LEDGER SCHEMA ──────────────────────────────────────────────────────────

model LedgerEntry {
  id              String            @id @default(uuid())
  walletId        String
  transactionId   String?
  transferId      String?
  type            LedgerEntryType
  amount          Decimal
  balance         Decimal
  status          LedgerEntryStatus @default(POSTED)
  description     String?
  reference       String?
  currency        String            @default("RWF")
  createdAt       DateTime          @default(now())

  wallet         Wallet?               @relation(fields: [walletId], references: [id])
  transaction    Transaction?           @relation(fields: [transactionId], references: [id])
  transfer       Transfer?              @relation(fields: [transferId], references: [id])
  reconciliations ReconciliationRecord[]

  @@map("ledger_entries")
  @@schema("finance")
  @@index([walletId, createdAt])
  @@index([transactionId])
  @@index([transferId])
  @@index([status])
}

// ── RECONCILIATION SCHEMA ──────────────────────────────────────────────────

model ReconciliationRecord {
  id              String               @id @default(uuid())
  providerName    String
  providerRef     String?
  providerAmount  Decimal
  providerStatus  String?
  providerDate    DateTime?
  transactionId   String?
  ledgerEntryId   String?
  status          ReconciliationStatus @default(PENDING)
  discrepancyType String?
  resolutionNote  String?
  resolvedBy      String?
  resolvedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  transaction Transaction? @relation(fields: [transactionId], references: [id])
  ledgerEntry LedgerEntry? @relation(fields: [ledgerEntryId], references: [id])

  @@map("reconciliation_records")
  @@schema("finance")
  @@index([status])
  @@index([providerName])
  @@index([transactionId])
}

// ── AML/FRAUD SCHEMA ───────────────────────────────────────────────────────

model RiskAssessment {
  id              String       @id @default(uuid())
  transactionId   String
  userId          String
  riskScore       Int
  riskLevel       RiskLevel
  signals         Json
  decision        RiskDecision @default(ALLOW)
  reviewNote      String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime     @default(now())

  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@map("risk_assessments")
  @@schema("finance")
  @@index([transactionId])
  @@index([userId])
  @@index([riskLevel])
  @@index([decision])
}

// ── APPROVAL WORKFLOWS SCHEMA ──────────────────────────────────────────────

model ApprovalRequest {
  id              String         @id @default(uuid())
  type            ApprovalType
  requestedById   String
  approvedById    String?
  targetType      String
  targetId        String
  payload         Json
  status          ApprovalStatus @default(PENDING)
  reason          String?
  rejectionReason String?
  expiresAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  requestedBy User  @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  approvedBy  User? @relation("ApprovalApprovedBy", fields: [approvedById], references: [id])

  @@map("approval_requests")
  @@schema("finance")
  @@index([status])
  @@index([type])
  @@index([requestedById])
}

// ── NOTIFICATIONS SCHEMA ────────────────────────────────────────────────────

model Notification {
  id          String               @id @default(uuid())
  userId      String?
  type        NotificationType     @default(INFO)
  category    NotificationCategory @default(NOTIFICATION)
  title       String
  message     String?
  isRead      Boolean              @default(false)
  isDismissed Boolean              @default(false)
  isGlobal    Boolean              @default(false)
  color       String?
  priority    String               @default("normal")
  dismissible Boolean              @default(true)
  link        String?
  linkText    String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime             @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("notifications")
  @@schema("notifications")
  @@index([userId, isRead])
  @@index([category])
}

// ── OBSERVABILITY SCHEMA (PUBLIC) ───────────────────────────────────────────

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?
  actorRole     String
  action        String
  targetType    String?
  targetId      String?
  metadata      Json?
  ipAddress     String?
  requestPath   String?
  result        String   @default("SUCCESS") // SUCCESS | FAILED | DENIED
  checksum      String? // SHA-256 of (id + action + targetType + targetId + metadata + createdAt) for tamper detection
  previousChecksum String? // Chain hash — links to previous audit log's checksum for integrity chain
  createdAt     DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
  @@schema("public")
  @@index([actorId, createdAt])
  @@index([action])
  @@index([targetType, targetId])
  @@index([result])
}

model SystemMetric {
  id         String   @id @default(uuid())
  metricName String
  value      Decimal
  labels     Json?
  recordedAt DateTime @default(now())

  @@map("system_metrics")
  @@schema("public")
  @@index([metricName, recordedAt])
}

// ── FINANCE EVENTS (Immutable Audit Trail) ─────────────────────────────────

model FinanceEvent {
  id            String   @id @default(uuid())
  eventType     String   @map("event_type")
  tableName     String   @map("table_name")
  recordId      String   @map("record_id")
  userId        String?  @map("user_id")
  oldValues     Json?    @map("old_values")
  newValues     Json?    @map("new_values")
  changedFields Json?    @map("changed_fields")
  ipAddress     String?  @map("ip_address")
  requestPath   String?  @map("request_path")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("finance_events")
  @@schema("public")
  @@index([tableName, recordId])
  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}
