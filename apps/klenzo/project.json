{
  "name": "klenzo",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/klenzo/src",
  "projectType": "application",
  "tags": ["scope:shared", "type:monolith", "type:library"],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "options": {
        "target": "node",
        "compiler": "tsc",
        "main": "apps/klenzo/src/main.ts",
        "tsConfig": "apps/klenzo/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "libs/proto",
            "output": "libs/proto"
          }
        ],
        "optimization": false,
        "outputHashing": "none",
        "generatePackageJson": true,
        "sourceMap": true,
        "outputPath": "dist/apps/klenzo",
        "webpackConfig": "apps/klenzo/webpack.config.js"
      },
      "configurations": {
        "development": {
          "optimization": false,
          "sourceMap": true,
          "poll": 1000
        },
        "production": {
          "optimization": true,
          "sourceMap": false
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "klenzo:build:development",
        "watch": true,
        "debounce": 500,
        "inspect": false
      },
      "configurations": {
        "development": {
          "buildTarget": "klenzo:build:development"
        },
        "production": {
          "buildTarget": "klenzo:build:production",
          "watch": false
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/klenzo/tsconfig.app.json --noEmit"
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    }
  }
}
