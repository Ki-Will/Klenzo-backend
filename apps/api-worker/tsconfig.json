{
  "extends": "../../tsconfig.base.json",
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ],
  "compilerOptions": {
    // Override base settings that are Node/NestJS specific.
    // Workers run in V8 directly — no Node globals, no CommonJS.
    "lib": ["ES2022", "WebWorker"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "target": "ES2022",

    // Workers-types ships the complete CF runtime typings (Request, Response,
    // crypto, cache, KV, Durable Objects, Service bindings, …).
    "types": ["@cloudflare/workers-types"],

    // Hono uses standard ESM; no CJS interop layer needed.
    "esModuleInterop": false,

    // Decorators and reflect-metadata are NOT needed in Hono Workers.
    "experimentalDecorators": false,
    "emitDecoratorMetadata": false,

    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
